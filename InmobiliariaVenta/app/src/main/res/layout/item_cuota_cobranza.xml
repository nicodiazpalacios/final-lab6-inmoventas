<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Cuota Icon/Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_cuota_indicador"
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardBackgroundColor="@color/colorPrimaryFixed"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_cuota_numero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Information: Concepto + Detalle/Fecha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cuota_concepto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuota 1 de 12"
                android:textColor="@color/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cuota_subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pendiente de pago"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Amount and Action Button/Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_cuota_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 5,000"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cuota_cobrar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Cobrar"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/colorPrimary"
                android:textColor="@color/colorOnPrimary"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <TextView
                android:id="@+id/tv_cuota_estado_pagado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#D1F8DF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="PAGADA"
                android:textColor="#006C49"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
