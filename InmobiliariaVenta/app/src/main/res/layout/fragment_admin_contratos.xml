                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resumen de Contratos"
                            android:textColor="@color/colorOnPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="20dp"
                            android:text="Tienes 12 contratos activos este mes, representando un incremento del 15% respecto al trimestre anterior."
                            android:textColor="#DCE1FF"
                            android:textSize="14sp"
                            android:lineSpacingExtra="2dp" />

                        <!-- Stats & Chart Container -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:baselineAligned="false">

                            <!-- Values Column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <!-- Stat 1: Total Valor -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TOTAL VALOR"
                                    android:textColor="#90A8FF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="16dp"
                                    android:text="$2.4M"
                                    android:textColor="@color/colorOnPrimary"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <!-- Stat 2: Comisiones -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="COMISIONES"
                                    android:textColor="#90A8FF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="$142K"
                                    android:textColor="@color/colorOnPrimary"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Minimalist Visual Graph Placeholder -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="110dp"
                                app:cardBackgroundColor="#26FFFFFF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#33FFFFFF"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="bottom"
                                    android:orientation="horizontal"
                                    android:padding="12dp">

                                    <!-- Bar 1: 40% -->
                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="35dp"
                                        android:layout_marginEnd="4dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_rounded_corner"
                                        android:backgroundTint="@color/colorSecondaryFixedDim" />

                                    <!-- Bar 2: 65% -->
                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="55dp"
                                        android:layout_marginEnd="4dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_rounded_corner"
                                        android:backgroundTint="@color/colorSecondaryFixedDim" />

                                    <!-- Bar 3: 50% -->
                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="42dp"
                                        android:layout_marginEnd="4dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_rounded_corner"
                                        android:backgroundTint="@color/colorSecondaryFixedDim" />

                                    <!-- Bar 4: 90% -->
                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="75dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_rounded_corner"
                                        android:backgroundTint="@color/colorSecondaryContainer" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_nuevo_contrato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="Nuevo Contrato"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
