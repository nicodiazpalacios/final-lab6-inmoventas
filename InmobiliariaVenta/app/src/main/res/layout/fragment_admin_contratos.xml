<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    tools:context=".ui.admin.AdminContratosFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de Contratos"
                android:textColor="@color/colorPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="Administra y supervisa los acuerdos activos de tus clientes."
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <!-- Search and Filter Bar Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/colorOutlineVariant"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_buscar_contrato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/colorOutlineVariant"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_buscar_contrato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Buscar por cliente o propiedad..."
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter_status"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="FILTROS"
                            app:icon="@drawable/ic_tune"
                            app:iconGravity="textStart"
                            app:iconTint="@color/colorOnSurface"
                            app:strokeColor="@color/colorOutlineVariant"
                            android:textColor="@color/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sort_contracts"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="ORDEN"
                            app:icon="@drawable/ic_sort"
                            app:iconGravity="textStart"
                            app:iconTint="@color/colorOnSurface"
                            app:strokeColor="@color/colorOutlineVariant"
                            android:textColor="@color/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Empty State Card (Mostrado cuando no hay contratos cargados) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_empty_contracts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="@color/colorPrimaryFixed"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_contratos"
                            app:tint="@color/colorPrimary" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_empty_contracts_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="No hay contratos cargados"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_empty_contracts_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Presiona el botón + abajo a la derecha para registrar el primer contrato en el sistema."
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contracts List Container (poblado desde Room Database) -->
            <LinearLayout
                android:id="@+id/layout_contracts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Pagination Bar: < [1] [2] [3] [4] > -->
            <LinearLayout
                android:id="@+id/layout_pagination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:visibility="gone">

                <!-- Previous Page Button (<) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_page_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_prev"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&lt;"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Page Slot 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorPrimary"
                    app:cardCornerRadius="8dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tv_page_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="1"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Page Slot 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="2"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Page Slot 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="3"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Page Slot 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="4"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Next Page Button (>) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_page_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_next"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&gt;"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_nuevo_contrato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="Nuevo Contrato"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
