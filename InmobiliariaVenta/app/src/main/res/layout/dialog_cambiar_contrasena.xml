<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header con ícono, título y botón cerrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="#dce1ff"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_lock_lock"
                        app:tint="#00236f" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cambiar Contraseña"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actualiza tu clave de acceso"
                        android:textColor="@color/colorOutline"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/dialog_pass_btn_cerrar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/colorOutline"
                    android:contentDescription="Cerrar" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorOutlineVariant"
                android:layout_marginBottom="20dp"
                android:alpha="0.4" />

            <!-- Campo 1: Contraseña Actual -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña Actual"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_dialog_pass_actual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_background"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/colorOutline" />

                <EditText
                    android:id="@+id/et_dialog_pass_actual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Ingresa tu contraseña actual"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutlineVariant"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_toggle_pass_actual"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/colorOutline"
                    android:contentDescription="Mostrar contraseña" />
            </LinearLayout>

            <!-- Campo 2: Nueva Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva Contraseña"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_dialog_pass_nueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_background"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/colorOutline" />

                <EditText
                    android:id="@+id/et_dialog_pass_nueva"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Ingresa tu nueva contraseña"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutlineVariant"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_toggle_pass_nueva"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/colorOutline"
                    android:contentDescription="Mostrar contraseña" />
            </LinearLayout>

            <!-- Campo 3: Confirmar Nueva Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmar Nueva Contraseña"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_dialog_pass_confirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_background"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/colorOutline" />

                <EditText
                    android:id="@+id/et_dialog_pass_confirmar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Repite tu nueva contraseña"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutlineVariant"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_toggle_pass_confirmar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/colorOutline"
                    android:contentDescription="Mostrar contraseña" />
            </LinearLayout>

            <!-- Contenedor de Condiciones / Requisitos en tiempo real -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#f4f3fa"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu nueva contraseña debe contener:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface"
                    android:layout_marginBottom="10dp" />

                <!-- Requisito 1: Mínimo 6 caracteres -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/iv_pass_req_length"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_circle_outline"
                        app:tint="@color/colorOutline" />

                    <TextView
                        android:id="@+id/tv_pass_req_length"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Mínimo 6 caracteres"
                        android:textSize="12sp"
                        android:textColor="@color/colorOutline" />
                </LinearLayout>

                <!-- Requisito 2: Al menos una mayúscula -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/iv_pass_req_uppercase"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_circle_outline"
                        app:tint="@color/colorOutline" />

                    <TextView
                        android:id="@+id/tv_pass_req_uppercase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Al menos una letra mayúscula"
                        android:textSize="12sp"
                        android:textColor="@color/colorOutline" />
                </LinearLayout>

                <!-- Requisito 3: Al menos un número -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/iv_pass_req_number"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_circle_outline"
                        app:tint="@color/colorOutline" />

                    <TextView
                        android:id="@+id/tv_pass_req_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Al menos un número obligatorio"
                        android:textSize="12sp"
                        android:textColor="@color/colorOutline" />
                </LinearLayout>

                <!-- Requisito 4: Las contraseñas coinciden -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_pass_req_match"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_circle_outline"
                        app:tint="@color/colorOutline" />

                    <TextView
                        android:id="@+id/tv_pass_req_match"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Las contraseñas coinciden"
                        android:textSize="12sp"
                        android:textColor="@color/colorOutline" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mensaje de error inline -->
            <TextView
                android:id="@+id/tv_dialog_pass_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#ba1a1a"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Botones de Acción: Cancelar a la izquierda, Guardar a la derecha (Material Design) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_pass_btn_cancelar"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="Cancelar"
                    android:textColor="@color/colorOutline"
                    android:textSize="14sp"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_pass_btn_guardar"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Actualizar contraseña"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="12dp"
                    app:elevation="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
