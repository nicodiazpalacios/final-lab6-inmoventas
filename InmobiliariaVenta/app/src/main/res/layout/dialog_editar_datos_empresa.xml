<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header con ícono, título y botón cerrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="#dce1ff"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_real_estate_agent"
                        app:tint="#00236f" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datos de la Empresa"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configura la información visible al público"
                        android:textColor="@color/colorOutline"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/dialog_empresa_btn_cerrar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/colorOutline"
                    android:contentDescription="Cerrar" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorOutlineVariant"
                android:layout_marginBottom="20dp"
                android:alpha="0.4" />

            <!-- Campo Nombre de la Empresa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la Inmobiliaria"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_dialog_empresa_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_background"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/colorOutline" />

                <EditText
                    android:id="@+id/et_dialog_empresa_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Ej. Inmobiliaria Venta"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutlineVariant"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Campo Teléfono / WhatsApp -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono / WhatsApp de Contacto"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_dialog_empresa_telefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_background"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_whatsapp"
                    app:tint="#006c49" />

                <EditText
                    android:id="@+id/et_dialog_empresa_telefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="+54 9 11 5842-1102"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutlineVariant"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Campo Correo Electrónico -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo Electrónico Oficial"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_dialog_empresa_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_background"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="@color/colorOutline" />

                <EditText
                    android:id="@+id/et_dialog_empresa_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="contacto@inmoventas.com"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutlineVariant"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Campo Dirección -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección de la Oficina"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_dialog_empresa_direccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_background"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_location_on"
                    app:tint="@color/colorOutline" />

                <EditText
                    android:id="@+id/et_dialog_empresa_direccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Av. del Libertador 2450, Buenos Aires"
                    android:inputType="textPostalAddress"
                    android:maxLines="2"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutlineVariant"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Mensaje de error / advertencia -->
            <TextView
                android:id="@+id/dialog_empresa_tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorError"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Botones de Acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_empresa_btn_cancelar"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="Cancelar"
                    android:textColor="@color/colorOutline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_empresa_btn_guardar"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Guardar Cambios"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#00236f"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
