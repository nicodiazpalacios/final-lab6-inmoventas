<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Section: Search, Filters and Sorting (Pinned for instant access) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <!-- Expanded Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/search_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/colorPrimary" />
                <EditText
                    android:id="@+id/inputBusquedaResultados"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Buscar barrios o direcciones"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:inputType="text"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />
                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/colorOnSurfaceVariant" />
                <ImageView
                    android:id="@+id/btnFiltrosTune"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="2dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_tune"
                    app:tint="@color/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingBottom="6dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <!-- Active Filter Chip -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/chipPrecio"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/colorSecondaryContainer"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txtPrecioChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Precio"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/btnRemoveFilterPrecio"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="@color/colorOnSecondaryContainer"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Property Type Chip -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/chipTipoPropiedad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/colorSurfaceContainerHigh"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txtTipoPropiedad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tipo de propiedad"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/colorOnSurfaceVariant"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Active Ambientes Chip -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/chipAmbientes"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/colorSecondaryContainer"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txtAmbientesChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ambientes"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/btnRemoveFilterAmbientes"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="@color/colorOnSecondaryContainer"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Active Banos Chip -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/chipBanos"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/colorSecondaryContainer"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txtBanosChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Baños"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/btnRemoveFilterBanos"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="@color/colorOnSecondaryContainer"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Active Amenities Chip -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/chipAmenities"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/colorSecondaryContainer"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txtAmenitiesChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comodidades"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/btnRemoveFilterAmenities"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="@color/colorOnSecondaryContainer"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Active Disposicion Chip -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/chipDisposicion"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/colorSecondaryContainer"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txtDisposicionChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disposición"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/btnRemoveFilterDisposicion"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="@color/colorOnSecondaryContainer"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Banner Modo Sin Conexión -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModoOfflineResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/colorOfflineBannerStroke"
                app:cardBackgroundColor="@color/colorOfflineBannerBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cloud_off"
                        app:tint="@color/colorOfflineBannerIcon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo sin conexión"
                            android:textColor="@color/colorOfflineBannerText"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Mostrando catálogo guardado en este dispositivo."
                            android:textColor="@color/colorOfflineBannerSubtext"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Results Header and Sorting in a compact row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtResultadosTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Propiedades publicadas"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/txtResultadosCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cargando propiedades..."
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Sorting Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnOrdenar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/txtSortOption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recomendados"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_expand_more"
                            app:tint="@color/colorOnSurface"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Frame container for smoothly recycled Results and Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- RecyclerView for Results (Hardware accelerated with view recycling) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchResultsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="vertical"
                tools:listitem="@layout/item_propiedad_destacada" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/colorOutline" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No se encontraron propiedades"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Intenta ajustar tus filtros o buscar con otro término."
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
