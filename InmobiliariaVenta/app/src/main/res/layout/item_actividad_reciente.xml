<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Icono de Actividad -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_actividad_icono_bg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E6F4EA"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_actividad_icono"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_real_estate_agent"
                app:tint="#006C49" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Información central -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <!-- Fila superior: Badge de Tipo y Horario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_badge_tipo_actividad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="NUEVA PROPIEDAD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#006C49"
                    android:background="@drawable/tag_background"
                    android:backgroundTint="#E6F4EA" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_actividad_horario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hace 15 min"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="Hace 15 min" />
            </LinearLayout>

            <!-- Fila central: Nombre de la propiedad -->
            <TextView
                android:id="@+id/tv_actividad_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Apartamento Loft Skywalk"
                android:textColor="@color/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Apartamento Loft Skywalk" />

            <!-- Fila inferior: Precio y Detalle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_actividad_precio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$450,000 USD"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="$450,000 USD" />

                <TextView
                    android:id="@+id/tv_actividad_detalle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="• Antes $485,000 USD"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="• Antes $485,000 USD" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flecha indicadora -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_expand_more"
            android:rotation="270"
            app:tint="@color/colorOutline" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
