<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ViewPager2 para cambiar fotos -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_visor_fotos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra Superior -->
    <LinearLayout
        android:id="@+id/topBarVisor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_cerrar_visor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_visor_contador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 de 1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_visor_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Propiedad"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Flecha Anterior -->
    <ImageView
        android:id="@+id/btn_foto_anterior"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/search_background"
        android:backgroundTint="#80000000"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Flecha Siguiente -->
    <ImageView
        android:id="@+id/btn_foto_siguiente"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/search_background"
        android:backgroundTint="#80000000"
        android:padding="10dp"
        android:rotation="180"
        android:src="@drawable/ic_arrow_back"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Hint de zoom en la parte inferior -->
    <TextView
        android:id="@+id/tv_visor_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/search_background"
        android:backgroundTint="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Pellizca o doble toque para hacer zoom"
        android:textColor="#E0E0E0"
        android:textSize="12sp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
