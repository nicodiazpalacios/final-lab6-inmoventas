<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    tools:context=".ui.admin.AdminMensajesFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_mensajes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Botón de regreso -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorPrimary"
                android:contentDescription="Volver" />

            <!-- Encabezado -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensajes de Clientes"
                android:textColor="@color/colorPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Consultas directas recibidas desde las publicaciones."
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <!-- Barra de Búsqueda -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_search"
                app:boxBackgroundColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_buscar_mensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar por cliente, propiedad o mensaje..."
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Filtros por Chips & Fecha -->
            <HorizontalScrollView
                android:id="@+id/scroll_chips_mensajes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_mensajes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_todos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Todos"
                            android:checked="true"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_no_leidos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No leídos"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_leidos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Leídos"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_fecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Por fecha"
                        app:chipIcon="@drawable/ic_calendar_today"
                        app:chipIconTint="@color/colorPrimary"
                        app:closeIconVisible="false"
                        app:closeIconTint="@color/colorPrimary"
                        style="@style/Widget.MaterialComponents.Chip.Action" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Contenedor dinámico de mensajes -->
            <LinearLayout
                android:id="@+id/layout_page_1_mensajes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <!-- Estado sin resultados -->
            <LinearLayout
                android:id="@+id/layout_empty_mensajes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/colorOutline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No se encontraron mensajes"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Probá modificando los filtros o la búsqueda."
                    android:textColor="@color/colorOutline"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Barra de Paginación Dinámica (< [1] [2] [3] [4] >) -->
            <LinearLayout
                android:id="@+id/layout_pagination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp">

                <!-- Botón Anterior (<) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_page_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_prev"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&lt;"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Slot 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorPrimary"
                    app:cardCornerRadius="8dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tv_page_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="1"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Slot 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="2"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Slot 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="3"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Slot 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_page_4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="4"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón Siguiente (>) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_page_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_page_next"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&gt;"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
