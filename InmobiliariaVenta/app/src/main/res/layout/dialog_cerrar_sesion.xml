<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Ícono decorativo de cerrar sesión -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#FFDAD6"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logout"
                app:tint="@color/colorError" />
        </androidx.cardview.widget.CardView>

        <!-- Título -->
        <TextView
            android:id="@+id/tv_dialog_logout_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Cerrar Sesión?"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Mensaje -->
        <TextView
            android:id="@+id/tv_dialog_logout_mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Estás seguro de que deseas salir de tu cuenta? Tendrás que volver a ingresar tu correo y contraseña para acceder."
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <!-- Botones: No (cancelar) a la izquierda, Sí (confirmar) a la derecha (Material Design) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="2">

            <!-- Botón No / Cancelar (Izquierda) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_logout_no"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:text="No, volver"
                android:textSize="13sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/colorSurfaceContainerHigh"
                android:textColor="@color/colorOnSurface"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <!-- Botón Sí / Confirmar (Derecha) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_logout_si"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:text="Sí, cerrar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/colorError"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
