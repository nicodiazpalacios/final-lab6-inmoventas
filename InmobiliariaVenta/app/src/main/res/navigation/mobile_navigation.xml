<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_inicio">

    <fragment
        android:id="@+id/nav_inicio"
        android:name="com.example.inmobiliariaventa.ui.home.HomeUsuarioFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home_usuario">
        <action
            android:id="@+id/action_nav_inicio_to_nav_search_location"
            app:destination="@id/nav_search_location"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_nav_inicio_to_nav_resultados_busqueda"
            app:destination="@id/nav_resultados_busqueda"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_search_location"
        android:name="com.example.inmobiliariaventa.ui.home.SearchLocationFragment"
        android:label="Ubicación"
        tools:layout="@layout/fragment_search_location">
        <action
            android:id="@+id/action_nav_search_location_to_nav_resultados_busqueda"
            app:destination="@id/nav_resultados_busqueda"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_nav_search_location_to_nav_buscar"
            app:destination="@id/nav_buscar"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_buscar"
        android:name="com.example.inmobiliariaventa.ui.home.FiltrosFragment"
        android:label="Filtros"
        tools:layout="@layout/fragment_filtros">
        <action
            android:id="@+id/action_nav_buscar_to_nav_search_location"
            app:destination="@id/nav_search_location"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_nav_buscar_to_nav_resultados_busqueda"
            app:destination="@id/nav_resultados_busqueda"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_perfil"
        android:name="com.example.inmobiliariaventa.ui.usuarios.PerfilUsuarioFragment"
        android:label="Perfil de Usuario"
        tools:layout="@layout/fragment_perfil_usuario">
        <action
            android:id="@+id/action_nav_perfil_to_nav_cliente_notificaciones"
            app:destination="@id/nav_cliente_notificaciones"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_nav_perfil_to_nav_guardados"
            app:destination="@id/nav_guardados"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_guardados"
        android:name="com.example.inmobiliariaventa.ui.list.MisFavoritosFragment"
        android:label="Mis Favoritos"
        tools:layout="@layout/fragment_mis_favoritos" />

    <fragment
        android:id="@+id/nav_detalle_propiedad"
        android:name="com.example.inmobiliariaventa.ui.propiedades.PropiedadDetalleFragment"
        android:label="Detalles de Propiedad"
        tools:layout="@layout/fragment_propiedad_detalle">
        <argument
            android:name="propiedad_id"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_resultados_busqueda"
        android:name="com.example.inmobiliariaventa.ui.list.ResultadosBusquedaFragment"
        android:label="Resultados de Búsqueda"
        tools:layout="@layout/fragment_resultados_busqueda">
        <action
            android:id="@+id/action_nav_resultados_busqueda_to_nav_buscar"
            app:destination="@id/nav_buscar"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_login"
        android:name="com.example.inmobiliariaventa.ui.usuarios.LoginFragment"
        android:label="Iniciar Sesión"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_nav_login_to_nav_admin_home"
            app:destination="@id/nav_admin_home"
            app:popUpTo="@id/nav_inicio"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_nav_login_to_nav_inicio"
            app:destination="@id/nav_inicio"
            app:popUpTo="@id/nav_inicio"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_registro"
        android:name="com.example.inmobiliariaventa.ui.usuarios.RegistroFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_registro" />

    <fragment
        android:id="@+id/nav_admin_home"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminHomeFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_home">
        <action
            android:id="@+id/action_nav_admin_home_to_nav_inicio"
            app:destination="@id/nav_inicio" />
        <action
            android:id="@+id/action_nav_admin_home_to_nav_admin_propiedades"
            app:destination="@id/nav_admin_propiedades" />
        <action
            android:id="@+id/action_nav_admin_home_to_nav_admin_ventas"
            app:destination="@id/nav_admin_ventas" />
        <action
            android:id="@+id/action_nav_admin_home_to_nav_admin_configuracion"
            app:destination="@id/nav_admin_configuracion" />
        <action
            android:id="@+id/action_nav_admin_home_to_nav_contratos"
            app:destination="@id/nav_contratos" />
        <action
            android:id="@+id/action_nav_admin_home_to_nav_admin_notificaciones"
            app:destination="@id/nav_admin_notificaciones" />
        <action
            android:id="@+id/action_nav_admin_home_to_nav_admin_mensajes"
            app:destination="@id/nav_admin_mensajes" />
    </fragment>

    <fragment
        android:id="@+id/nav_admin_propiedades"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminPropiedadesFragment"
        android:label="Gestión de Propiedades"
        tools:layout="@layout/fragment_admin_propiedades" />

    <fragment
        android:id="@+id/nav_admin_perfil"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminPerfilFragment"
        android:label="Perfil Administrador"
        tools:layout="@layout/fragment_admin_perfil" />

    <fragment
        android:id="@+id/nav_admin_agregar_propiedad"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminAgregarPropiedadFragment"
        android:label="Publicar Propiedad"
        tools:layout="@layout/fragment_admin_agregar_propiedad" />

    <fragment
        android:id="@+id/nav_admin_ventas"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminVentasFragment"
        android:label="Analíticas de Ventas"
        tools:layout="@layout/fragment_admin_ventas">
        <action
            android:id="@+id/action_nav_admin_ventas_to_nav_admin_propiedades_vendidas"
            app:destination="@id/nav_admin_propiedades_vendidas" />
    </fragment>

    <fragment
        android:id="@+id/nav_admin_propiedades_vendidas"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminPropiedadesVendidasFragment"
        android:label="Historial Reciente"
        tools:layout="@layout/fragment_admin_propiedades_vendidas" />

    <fragment
        android:id="@+id/nav_admin_configuracion"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminConfiguracionFragment"
        android:label="Configuración"
        tools:layout="@layout/fragment_admin_configuracion">
        <action
            android:id="@+id/action_nav_admin_configuracion_to_nav_admin_gestion_usuarios"
            app:destination="@id/nav_admin_gestion_usuarios" />
    </fragment>

    <fragment
        android:id="@+id/nav_admin_gestion_usuarios"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminGestionUsuariosFragment"
        android:label="Gestión de Usuarios"
        tools:layout="@layout/fragment_admin_gestion_usuarios" />

    <fragment
        android:id="@+id/nav_contratos"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminContratosFragment"
        android:label="Gestionar Contratos"
        tools:layout="@layout/fragment_admin_contratos">
        <action
            android:id="@+id/action_nav_contratos_to_nav_admin_agregar_contrato"
            app:destination="@id/nav_admin_agregar_contrato" />
    </fragment>

    <fragment
        android:id="@+id/nav_admin_agregar_contrato"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminAgregarContratoFragment"
        android:label="Nuevo Contrato"
        tools:layout="@layout/fragment_admin_agregar_contrato" />

    <fragment
        android:id="@+id/nav_admin_notificaciones"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminNotificacionesFragment"
        android:label="Notificaciones"
        tools:layout="@layout/fragment_admin_notificaciones" />

    <fragment
        android:id="@+id/nav_admin_mensajes"
        android:name="com.example.inmobiliariaventa.ui.admin.AdminMensajesFragment"
        android:label="Mensajes de Clientes"
        tools:layout="@layout/fragment_admin_mensajes" />

    <fragment
        android:id="@+id/nav_cliente_notificaciones"
        android:name="com.example.inmobiliariaventa.ui.home.ClienteNotificacionesFragment"
        android:label="Mis Notificaciones"
        tools:layout="@layout/fragment_cliente_notificaciones" />

</navigation>
